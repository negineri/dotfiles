## ウィンドウのインデックスを1から始める
set -g base-index 1
## ペインのインデックスを1から始める
setw -g pane-base-index 1
set -g mouse on
setw -g mode-keys vi
# set-window-option -g mode-keys vi
# bind-key m if-shell "tmux show -g mouse | grep off" "set -g mouse on" "set -g mouse off"
# set-option -g default-terminal "tmux-256color" # 基本的にはscreen-256colorかtmux-256colorを設定
set-option -g default-terminal "screen-256color"
# set-option -ga terminal-overrides ",$TERM:Tc:smcup@:rmcup@" # tmuxを起動してい>ない時のzshでの$TERMの値を指定
set-option -ga terminal-overrides ",$TERM:Tc" # tmuxを起動していない時のzshでの$TERMの値を指定

set-option -g history-limit 10000

{{ if .client -}}
set -g set-clipboard on
set-option -g prefix C-t

## コピーモード (vi) で選択したテキストをシステムクリップボードにコピーする
bind-key -T copy-mode-vi v send-keys -X begin-selection
{{ if eq .chezmoi.os "darwin" -}}
bind-key -T copy-mode-vi y send-keys -X copy-pipe-and-cancel "pbcopy"
bind-key -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel "pbcopy"
{{ else -}}
bind-key -T copy-mode-vi y send-keys -X copy-pipe-and-cancel "wl-copy 2>/dev/null || xclip -selection clipboard"
bind-key -T copy-mode-vi MouseDragEnd1Pane send-keys -X copy-pipe-and-cancel "wl-copy 2>/dev/null || xclip -selection clipboard"
{{ end -}}
{{ end -}}

#!/bin/bash

{{- if not .decrypt }}
exit 0
{{- end }}

# if ! command -v bw >/dev/null; then
    echo "install bitwarden cli"
{{- if eq .chezmoi.os "darwin" }}
    curl -L -o /tmp/bw.zip "https://github.com/bitwarden/clients/releases/download/cli-v2026.8.0/bw-macos-arm64-2026.8.0.zip"
{{- else if eq .chezmoi.os "linux" }}
    curl -L -o /tmp/bw.zip "https://github.com/bitwarden/clients/releases/download/cli-v2026.8.0/bw-linux-2026.8.0.zip"
{{- end }}
    unzip -o /tmp/bw.zip -d /tmp
    mkdir -p $HOME/.local/bin
    mv /tmp/bw $HOME/.local/bin/bw
    rm -f /tmp/bw.zip
    bw login || true
# fi

# chezmoi renders every template before writing any file, so the age key
# has to be in place before it decrypts .ssh/config_secret and the others
key="$HOME/.config/chezmoi/key.txt"
if [[ ! -f "$key" ]]; then
    BW_SESSION="$(bw unlock --raw)" || exit 1
    export BW_SESSION
    mkdir -p "$(dirname "$key")"
    (umask 077 && bw get notes {{ include "dot_config/chezmoi/private_key.txt.tmpl" | regexFind "[0-9a-f-]{36}" }} > "$key.tmp") || { rm -f "$key.tmp"; exit 1; }
    echo >> "$key.tmp"
    mv "$key.tmp" "$key"
fi

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "cleanupPeriodDays": 30,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(uv run pytest:*)",
      "Bash(uv run ruff:*)",
      "Bash(uv run mypy:*)",
      "Bash(git commit:*)",
      "Bash(git add:*)",
      "Bash(pytest:*)",
      "Bash(ruff:*)",
      "Bash(mypy:*)",
      "Edit(**)",
      "Grep(**)",
      "Read(**)",
      "WebFetch"
    ],
    "ask": [
      "Bash(git restore*)"
    ],
    "deny": [
      "Bash(* | bash)",
      "Bash(* | sh)",
      "Bash(> /dev/sda*)",
      "Bash(apt-get install*)",
      "Bash(brew install*)",
      "Bash(bundle install*)",
      "Bash(chmod -R 777*)",
      "Bash(chmod 777*)",
      "Bash(chown -R*)",
      "Bash(dd *)",
      "Bash(format *)",
      "Bash(gem install*)",
      "Bash(gh api --method DELETE*)",
      "Bash(gh auth logout*)",
      "Bash(gh auth refresh*)",
      "Bash(gh gist create*)",
      "Bash(gh gist delete*)",
      "Bash(gh gpg-key add*)",
      "Bash(gh gpg-key delete*)",
      "Bash(gh release create*)",
      "Bash(gh release delete*)",
      "Bash(gh release upload*)",
      "Bash(gh repo archive*)",
      "Bash(gh repo create*)",
      "Bash(gh repo delete*)",
      "Bash(gh repo deploy-key*)",
      "Bash(gh repo edit*)",
      "Bash(gh repo fork*)",
      "Bash(gh repo rename*)",
      "Bash(gh repo sync*)",
      "Bash(gh repo unarchive*)",
      "Bash(gh secret delete*)",
      "Bash(gh secret set*)",
      "Bash(gh ssh-key add*)",
      "Bash(gh ssh-key delete*)",
      "Bash(gh workflow disable*)",
      "Bash(gh workflow enable*)",
      "Bash(gh workflow run*)",
      "Bash(git config --global*)",
      "Bash(git config --system*)",
      "Bash(git rebase*)",
      "Bash(git reset --hard*)",
      "Bash(mkfs *)",
      "Bash(npm install -g*)",
      "Bash(pip install*)",
      "Bash(rm -fr /*)",
      "Bash(rm -fr ~*)",
      "Bash(rm -rf \"$HOME\"*)",
      "Bash(rm -rf $HOME*)",
      "Bash(rm -rf ../*)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(sudo *)",
      "Bash(yum install*)",
      "Read(**/.env*)",
      "Read(**/key.txt*)",
      "Read(~/.config/chezmoi/**)",
      "Read(~/.ssh/**)"
    ]
  },
{{- if eq .chezmoi.os "darwin" }}
  "hooks": {
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"確認待ち\" with title \"Claude Code\" sound name \"Tink\"'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "osascript -e 'display notification \"タスク完了\" with title \"Claude Code\" sound name \"Tink\"'"
          }
        ]
      }
    ]
  },
{{- end }}
  "enableWorkflows": true,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/scripts/statusline.sh"
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": true
  },
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "model": "opus",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true{{- if .decrypt }},
  "autoMode": {{ include ".chezmoisecrets/claude-automode.json.age" | decrypt | trim | indent 2 | trim }}
{{- end }}
}

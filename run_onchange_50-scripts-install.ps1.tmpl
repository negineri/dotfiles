{{- with (index .packages .profile) }}{{ if not (hasKey . "scripts") }}
exit 0
{{- end }}{{ end }}

{{ $chezmoi_source_dir := .chezmoi.sourceDir }}
{{- with (index .packages .profile) }}{{ if hasKey . "scripts" }}{{ range .scripts }}
{{- if stat (joinPath $chezmoi_source_dir "scripts" (printf "install-%s.ps1" .)) }}
# install-{{ . }}.ps1 hash: {{ include (printf "%s%s%s" "scripts/install-" . ".ps1") | sha256sum }}
& powershell -NoLogo -NoProfile -ExecutionPolicy Bypass -File "{{ $chezmoi_source_dir }}/scripts/install-{{ . }}.ps1"
{{ end }}
{{- end }}{{ end }}{{ end }}

{{- if not .decrypt }}
exit 0
{{- end }}
# profiles.yaml hash: {{ include "dot_config/resticprofile/profiles.yaml.tmpl" | sha256sum }}

# exit non-zero on failure so chezmoi retries this script on the next apply
$resticprofile = "$env:LOCALAPPDATA\Microsoft\WinGet\Packages\creativeprojects.resticprofile_Microsoft.Winget.Source_8wekyb3d8bbwe\resticprofile.exe"
$dir = Join-Path $HOME ".config\resticprofile"
$config = Join-Path $dir "profiles.yaml"
if (-not (Test-Path $resticprofile)) {
    Write-Host "resticprofile not found"
    exit 1
}
# on a fresh machine profiles.yaml is rendered before winget installs restic
if (-not (Select-String -Path $config -Pattern 'restic-binary: ".+"' -Quiet)) {
    Write-Host "restic was not installed when profiles.yaml was written; run chezmoi apply again"
    exit 1
}

# keep the repository password readable by the current user and SYSTEM only
$user = [Security.Principal.WindowsIdentity]::GetCurrent().User.Value
icacls (Join-Path $dir "password.txt") /inheritance:r /grant:r "*${user}:F" "*S-1-5-18:F" /q
if ($LASTEXITCODE -ne 0) {
    exit 1
}

function Invoke-Profile {
    & $resticprofile --config $config @args
}

Invoke-Profile base.cat config *> $null
if ($LASTEXITCODE -ne 0) {
    Invoke-Profile base.init
    if ($LASTEXITCODE -ne 0) {
        exit 1
    }
}

# restore each library on a new machine, before its app creates an empty one
$musicbeeSettings = Join-Path $env:LOCALAPPDATA "Packages\50072StevenMayall.MusicBee_kcr266et74avj\LocalCache\Roaming\MusicBee"
$apps = @(
    @{ profile = "apple-music"; process = "AppleMusic"; marker = "Apple Music Library.musiclibrary"; paths = @((Join-Path $HOME "Music\Apple Music")) },
    @{ profile = "musicbee"; process = "MusicBee"; marker = "MusicBeeLibrary.mbl"; paths = @((Join-Path $HOME "Music\MusicBee"), $musicbeeSettings) }
)
foreach ($app in $apps) {
    $library = $app.paths[0]
    if (Test-Path (Join-Path $library $app.marker)) {
        continue
    }
    if (Get-Process $app.process -ErrorAction SilentlyContinue) {
        Write-Host "close $($app.process) first"
        exit 1
    }
    # the profiles share one repository, so pick this profile's snapshots by path
    $snapshots = Invoke-Profile "$($app.profile).snapshots" --path $library --json | ConvertFrom-Json
    if (-not $snapshots) {
        continue
    }
    foreach ($path in $app.paths) {
        # restic stores C:\Users\x as /C/Users/x
        $inSnapshot = "/" + ($path -replace ':', '' -replace '\\', '/')
        Invoke-Profile "$($app.profile).restore" "latest:$inSnapshot" --path $library --target $path
        if ($LASTEXITCODE -ne 0) {
            exit 1
        }
    }
}

foreach ($app in $apps) {
    Invoke-Profile "$($app.profile).schedule"
    if ($LASTEXITCODE -ne 0) {
        exit 1
    }
}

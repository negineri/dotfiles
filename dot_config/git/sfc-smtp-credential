#!/bin/sh

[ "$1" = get ] || exit 0

if [ -x "$HOME/.local/bin/bw" ]; then
    bw="$HOME/.local/bin/bw"
else
    bw=bw
fi

if [ -z "${BW_SESSION:-}" ]; then
    if ! ( : </dev/tty ) 2>/dev/null; then
        printf '%s\n' 'Bitwarden unlock requires a terminal or an existing BW_SESSION.' >&2
        printf 'quit=true\n'
        exit 0
    fi
    if ! BW_SESSION=$("$bw" unlock --raw </dev/tty 2>/dev/tty) || [ -z "$BW_SESSION" ]; then
        printf '%s\n' 'Could not unlock Bitwarden.' >&2
        printf 'quit=true\n'
        exit 0
    fi
    export BW_SESSION
fi

if item=$("$bw" get item cb80ade6-db8a-4eca-901f-acff0121ecee); then
    if printf '%s\n' "$item" | perl -MJSON::PP -0777 -ne '
        my $login = eval { decode_json($_)->{login} };
        my ($username, $password) = @{$login // {}}{qw(username password)};
        for ($username, $password) {
            exit 1 unless defined && length && !/[\r\n\0]/;
        }
        binmode STDOUT, ":encoding(UTF-8)";
        print "username=$username\npassword=$password\n";
    '; then
        exit 0
    fi
    printf '%s\n' 'The Bitwarden item must contain a login username and password.' >&2
else
    printf '%s\n' 'Unlock Bitwarden with export BW_SESSION="$(bw unlock --raw)" and retry.' >&2
fi
printf 'quit=true\n'

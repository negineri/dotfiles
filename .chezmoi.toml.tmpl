{{- $interactive := stdinIsATTY }}

{{- $profile := "" }}
{{- $client := false }}
{{- $rootless := false }}
{{- $decrypt := false }}
{{- if hasKey . "profile" -}}
{{-   $profile = .profile }}
{{-   $client = .client }}
{{-   $rootless = .rootless }}
{{-   $decrypt = .decrypt }}
{{- else if eq .chezmoi.hostname "fugaku" }}
{{-   $profile = "debian_client" }}
{{-   $client = true }}
{{-   $decrypt = true }}
{{- else if eq .chezmoi.os "darwin" }}
{{-   $profile = "darwin_client" }}
{{-   $client = true }}
{{-   $decrypt = true }}
{{- else if eq .chezmoi.os "windows" }}
{{-   $profile = "windows_client" }}
{{-   $client = true }}
{{-   $decrypt = true }}
{{- else if (promptBool "Client PC?" false) }}
{{-   $profile = "debian_client" }}
{{-   $client = true }}
{{-   $decrypt = true }}
{{- else  }}
{{-   $profile = "debian_server" }}
{{- end }}

{{- if $interactive }}
{{-   writeToStdout "Tip: you can re-enter your name and email with `chezmoi init --data=false`.\n" }}
{{- end }}
encryption = "age"
[age]
    identity = "~/.config/chezmoi/key.txt"
    recipient = "age1vdrqpsfk7f70fjz83gwqt2yxg5v4lh9x3uxejy9pxvt9w00gsuqsd8y94x"
[edit]
{{- if eq .chezmoi.os "windows" }}
    command = "notepad"
[interpreters.ps1]
    command = "powershell"
    args = ["-NoLogo", "-NoProfile", "-ExecutionPolicy", "Bypass"]
{{- else }}
    command = "vim"
{{- end }}
[git]
    autoCommit = true
[data]
    profile = "{{ $profile }}"
    client = {{ $client }}
    rootless = {{ $rootless }}
    decrypt = {{ $decrypt }}
[bitwarden]
    unlock = "auto"
{{- if eq .chezmoi.os "windows" }}
    # winget puts bw on PATH only for new shells, so chezmoi calls it by its full path
    command = '{{ env "LOCALAPPDATA" }}\Microsoft\WinGet\Packages\Bitwarden.CLI_Microsoft.Winget.Source_8wekyb3d8bbwe\bw.exe'
{{- end }}

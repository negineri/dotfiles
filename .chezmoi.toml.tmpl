{{- $interactive := stdinIsATTY }}

{{- $profile := "" }}
{{- $client := false }}
{{- $rootless := false }}
{{- $decrypt := false }}
{{- if hasKey . "profile" -}}
{{-   $profile = .profile }}
{{-   $client = .client }}
{{-   $rootless = .rootless }}
{{-   $decrypt = .decrypt }}
{{- else if eq .chezmoi.hostname "fugaku" }}
{{-   $profile = "debian_client" }}
{{-   $client = true }}
{{-   $decrypt = true }}
{{- else if eq .chezmoi.os "darwin" }}
{{-   $profile = "darwin_client" }}
{{-   $client = true }}
{{-   $decrypt = true }}
{{- else if (promptBool "Client PC?" false) }}
{{-   $profile = "debian_client" }}
{{-   $client = true }}
{{-   $decrypt = true }}
{{- else  }}
{{-   $profile = "debian_server" }}
{{- end }}

{{- if $interactive }}
{{-   writeToStdout "Tip: you can re-enter your name and email with `chezmoi init --data=false`.\n" }}
{{- end }}
encryption = "age"
[age]
    identity = "~/.config/chezmoi/key.txt"
    recipient = "age1vdrqpsfk7f70fjz83gwqt2yxg5v4lh9x3uxejy9pxvt9w00gsuqsd8y94x"
[edit]
    command = "vim"
[git]
    autoCommit = true
[data]
    profile = "{{ $profile }}"
    client = {{ $client }}
    rootless = {{ $rootless }}
    decrypt = {{ $decrypt }}
[bitwarden]
    unlock = "auto"

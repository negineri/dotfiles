{{- with (index .packages .profile) }}{{ if not (hasKey . "winget") }}
exit 0
{{- end }}{{ end }}

# each entry is a package id, or { id, override, elevate } to pass the installer's own
# arguments or run winget elevated
$packages = @(
{{- with (index .packages .profile) }}{{ if hasKey . "winget" }}{{ range .winget }}
{{-   if kindIs "map" . }}
    @{ id = {{ .id | quote }}; override = '{{ get . "override" }}'; elevate = ${{ if get . "elevate" }}true{{ else }}false{{ end }} }
{{-   else }}
    @{ id = {{ . | quote }} }
{{-   end }}
{{-   end }}{{ end }}{{ end }}
)

$failed = @()
foreach ($pkg in $packages) {
    $id = $pkg.id
    winget list --id $id -e --accept-source-agreements | Out-Null
    if ($LASTEXITCODE -eq 0) {
        continue
    }
    Write-Host "install $id"
    $wingetArgs = @("install", "--id", $id, "-e", "--accept-source-agreements", "--accept-package-agreements")
    if ($pkg.override) {
        $wingetArgs += @("--override", $pkg.override)
    } else {
        $wingetArgs += "--silent"
    }
    if ($pkg.elevate) {
        # MSIX packages with a packaged service only install from an elevated winget
        # Start-Process joins arguments as is, so quote the ones with spaces
        $argLine = ($wingetArgs | ForEach-Object { if ($_ -match ' ') { "`"$_`"" } else { $_ } }) -join ' '
        $code = (Start-Process winget -ArgumentList $argLine -Verb RunAs -Wait -PassThru).ExitCode
    } else {
        & winget @wingetArgs
        $code = $LASTEXITCODE
    }
    if ($code -ne 0) {
        $failed += $id
    }
}

# exit non-zero so chezmoi retries this script on the next apply
if ($failed.Count -gt 0) {
    Write-Host "failed: $($failed -join ', ')"
    exit 1
}
